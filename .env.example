# ==============================================================================
# MaxxPixels OTT — Docker Production Environment (.env.example)
# Copy to `.env` on the VPS and fill in your real credentials.
#
# PostgreSQL runs OUTSIDE Docker on the VPS host.
# Containers reach the host PostgreSQL via `host.docker.internal:5432`.
# NOTE: If your DB password contains special characters (@, !, #, :, /),
#       URL-encode them in DATABASE_URL (e.g. @ -> %40, ! -> %21).
# ==============================================================================

# --- Host Ports (bound to 127.0.0.1 for Host Nginx reverse proxy) -------------
API_PORT=8081
WEB_PORT=3001
ADMIN_PORT=4200
GAMES_PORT=8090
STREAMER_PORT=8085

# --- Public URLs & CORS -------------------------------------------------------
PUBLIC_BASE_URL=https://api.maxxpixels.com
CORS_ALLOWED_ORIGINS=https://maxxpixels.com,https://www.maxxpixels.com,https://admin.maxxpixels.com,https://producer.maxxpixels.com

# --- External PostgreSQL on VPS Host (outside Docker) -------------------------
DATABASE_URL=postgresql://postgres:CHANGE_ME@host.docker.internal:5432/maxxpixels_ott?schema=public
DATABASE_MAX_CONNECTIONS=25
DATABASE_MIN_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT_SEC=10
DATABASE_IDLE_TIMEOUT_SEC=300

# Separate Games PostgreSQL DB on the same VPS host PostgreSQL
GAMES_DATABASE_URL=postgres://games_user:CHANGE_ME@host.docker.internal:5432/maxxpixels_games

# --- Redis (inside Docker) ----------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=20

# --- Rust API Runtime & Confluent Kafka (in Docker) ---------------------------
RUST_ENV=production
RUST_LOG=info
KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:9092

# --- Push & Email (FCM HTTP v1 via service account) ---------------------------
# Get JSON from: Firebase Console -> Project settings -> Service accounts -> Generate new private key
# Store at /etc/maxxpixels/fcm-service-account.json on the VPS (chmod 600, never commit)
# FCM_SERVICE_ACCOUNT_PATH=/etc/maxxpixels/fcm-service-account.json
# FCM_PROJECT_ID=maxxpixelsott
FCM_SERVICE_ACCOUNT_PATH=
FCM_PROJECT_ID=
RESEND_API_KEY=
EMAIL_FROM=noreply@maxxpixels.com

# --- JWT Authentication (shared between Rust API and Go Games service) --------
JWT_SECRET=CHANGE_ME_STRONG_64_CHAR_HEX_SECRET
JWT_EXPIRATION_SECONDS=86400
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# --- PlayforFun Games Service -------------------------------------------------
PLAYFORFUN_TENANT_ID=maxxpixels
PLAYFORFUN_SECRET=CHANGE_ME_PFF_HMAC_SECRET
PLAYER_TTL_SECONDS=86400
SUBSCRIPTION_GRANT_COINS=1000
SUBSCRIPTION_MONTHLY_COINS=100

# --- Bunny.net Stream & Storage -----------------------------------------------
BUNNY_STREAM_LIBRARY_ID=676868
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_STORAGE_ZONE_NAME=maxxpixels-images
BUNNY_STORAGE_ZONE_PASSWORD=
BUNNY_PULL_ZONE_DOMAIN=https://maxxpixels-images.b-cdn.net

# --- Razorpay Payments --------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GAMES_RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# --- SMS (MSG91) --------------------------------------------------------------
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
RECAPTCHA_SECRET_KEY=

# --- Rate Limiting ------------------------------------------------------------
DISABLE_RATE_LIMIT=false
RATE_LIMIT_GENERAL_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_PAYMENT_PER_MINUTE=30

# --- Admin & Producer Panel Runtime Variables (injected at container start) ---
ADMIN_API_HOST=
ADMIN_API_BASE_URL=/api/v1
ADMIN_APP_NAME=MaxxPixels OTT Admin

# --- Next.js Web Public Variables (baked in at build time) --------------------
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_APP_NAME=Maxxpixels
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GTM_ID=GTM-NCD2C9GP
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Le3Di8uAAAAACkUTTU7cl19KOTyzt2zDzq0-VRS
NEXT_PUBLIC_EXTRA_IMAGE_HOSTS=
