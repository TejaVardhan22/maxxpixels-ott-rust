# Install as /etc/maxxpixels-ott/backend.env, mode 0600.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=maxxpixels_ott
DB_USERNAME=maxx_app
DB_PASSWORD=replace-me
DB_SSL=false
DB_POOL_MAX=15
DB_POOL_MIN=2

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Pick an unused logical DB on the existing Redis instance.
REDIS_DB=1
REDIS_PASSWORD=

JWT_SECRET=replace-me
CORS_ALLOWED_ORIGINS=https://maxxpixels.com,https://www.maxxpixels.com,https://admin.maxxpixels.com,https://producer.maxxpixels.com
KEYCLOAK_ENABLED=false

# Existing databases should be checked and migrated explicitly before cutover.
DB_SCHEMA_PATCHES_ENABLED=false
SKIP_DB_INIT=true
KAFKA_ENABLED=true
# Async event bus runs on Redis Streams (no broker needed).
EVENT_BUS_ENABLED=true
EVENT_BUS_STREAM_KEY=ott:events:stream
EVENT_BUS_DLQ_KEY=ott:events:dlq
EVENT_BUS_CONSUMER_GROUP=ott-workers
EVENT_BUS_MAX_ATTEMPTS=5
# Keep disabled during parallel testing; enable once NestJS owns the outbox.
OUTBOX_RELAY_ENABLED=false
# Keep the VPS's current backup schedule unless explicitly replacing it.
NIGHTLY_BACKUP_ENABLED=false

# Copy the integrations actually in use from your production secrets.
STORAGE_PROVIDER=BUNNY
STREAM_PROVIDER=BUNNY
PAYMENT_PROVIDER=RAZORPAY
# Serve media through the backend proxy ($PUBLIC_BASE_URL/api/v1/uploads/...).
# Set to true only when the Bunny pull zone serves objects (not suspended).
MEDIA_DIRECT_CDN=false
