[Unit]
Description=MaxxPixels OTT Next.js web
After=network-online.target maxxpixels-nestjs.service

[Service]
User=maxx-next
Group=maxx-next
WorkingDirectory=/opt/maxxpixels-ott/current/web
EnvironmentFile=-/etc/maxxpixels-ott/web.env
ExecStart=/usr/bin/env NODE_ENV=production HOSTNAME=127.0.0.1 PORT=3001 API_BACKEND_URL=http://127.0.0.1:8081 /usr/bin/node /opt/maxxpixels-ott/current/web/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/maxxpixels-ott/current/web/.next/cache /opt/maxxpixels-ott/current/web/.next/server/app

[Install]
WantedBy=multi-user.target
