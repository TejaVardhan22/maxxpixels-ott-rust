# ==============================================================================
# MaxxPixels OTT platform environment (.env.ott)
#
# Source of truth for: API, web, admin, streamer, storage, payments, notifications.
# Run `python3 scripts/combine_env.py` to regenerate the combined root `.env`.
#
# PostgreSQL runs OUTSIDE Docker on the VPS host (host.docker.internal:5432).
# Redis and Confluent Kafka run INSIDE Docker.
# NOTE: Password special characters (@ -> %40, ! -> %21) are URL-encoded in URLs.
# ==============================================================================

# --- Host Ports (bound to 127.0.0.1 for Host Nginx reverse proxy) -------------
API_PORT=8081
WEB_PORT=3001
ADMIN_PORT=4200
STREAMER_PORT=8085

# --- Domain & Public URLs -----------------------------------------------------
DOMAIN=api.maxxpixels.com
SSL_EMAIL=admin@maxxpixels.com
PUBLIC_BASE_URL=https://api.maxxpixels.com
CORS_ALLOWED_ORIGINS=https://maxxpixels.com,https://www.maxxpixels.com,https://admin.maxxpixels.com,https://producer.maxxpixels.com

# --- External PostgreSQL on VPS Host (outside Docker) -------------------------
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=maxxpixels_ott
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DATABASE_URL=CHANGE_ME
DATABASE_MAX_CONNECTIONS=25
DATABASE_MIN_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT_SEC=10
DATABASE_IDLE_TIMEOUT_SEC=300
SKIP_DB_INIT=1
SKIP_DATA_INITIALIZER=1

# --- Redis --------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=20

# --- Apache Kafka -------------------------------------------------------------
KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=maxxott-rust-backend
KAFKA_CONSUMER_GROUP=maxx-ott-group-rust-shadow

# --- Rust API runtime ---------------------------------------------------------
RUST_ENV=production
RUST_LOG=info
DISABLE_RATE_LIMIT=false
RATE_LIMIT_GENERAL_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_PAYMENT_PER_MINUTE=30

# --- Admin & Producer Panel Runtime Variables ---------------------------------
ADMIN_API_HOST=
ADMIN_API_BASE_URL=/api/v1
ADMIN_APP_NAME=MaxxPixels OTT Admin

# --- Next.js Web Public Variables (baked in at build time) ---------------------
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_APP_NAME=Maxxpixels
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_EXTRA_IMAGE_HOSTS=

# --- Push & Email -------------------------------------------------------------
FCM_SERVER_KEY=CHANGE_ME
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@maxxpixels.com

# --- Shared auth (must match the games service JWT_SECRET) --------------------
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION_SECONDS=86400
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# --- Storage (Bunny.net) ------------------------------------------------------
BUNNY_STORAGE_ZONE_NAME=maxxpixels-images
BUNNY_STORAGE_ZONE_PASSWORD=CHANGE_ME
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_STORAGE_REGION=
BUNNY_PULL_ZONE_DOMAIN=https://maxxpixels-images.b-cdn.net
BUNNY_STREAM_LIBRARY_ID=676868
BUNNY_STREAM_API_KEY=CHANGE_ME
BUNNY_STREAM_CDN_HOSTNAME=vz-bb76d46f-94f.b-cdn.net
BUNNY_STREAM_TOKEN_AUTH_KEY=CHANGE_ME

# --- Payments (Razorpay; shared with games) -----------------------------------
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# --- SMS / OTP ----------------------------------------------------------------
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=CHANGE_ME
MSG91_TEMPLATE_ID=CHANGE_ME
MSG91_SENDER_ID=MAXXPX
# Optional transactional templates. Leave blank to disable the related SMS.
# Flow variables used by the API: VAR1, VAR2, VAR3.
MSG91_TRANSACTIONAL_TEMPLATE_ID=
MSG91_PAYMENT_TEMPLATE_ID=
MSG91_SUBSCRIPTION_TEMPLATE_ID=
MSG91_PRODUCER_TEMPLATE_ID=
SMS=CHANGE_ME
