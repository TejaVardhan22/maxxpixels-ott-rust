# =============================================================================
# MaxxPixels OTT — Rust Backend Environment Configuration (.env)
# =============================================================================

# Server Environment
RUST_ENV=development
PORT=8081
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173,http://localhost:8080,https://maxxpixels.com,https://admin.maxxpixels.com

# PostgreSQL Connection (matching existing production database)
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/maxxpixels_ott?schema=public
DATABASE_MAX_CONNECTIONS=25
DATABASE_MIN_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT_SEC=10
DATABASE_IDLE_TIMEOUT_SEC=300

# Redis Connection
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=20

# Apache Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=maxxott-rust-backend
KAFKA_CONSUMER_GROUP=maxx-ott-group-rust-shadow
KAFKA_ENABLED=true

# JWT Authentication
JWT_SECRET=CHANGE_ME_STRONG_64_CHAR_HEX_SECRET
JWT_EXPIRATION_SECONDS=86400
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# Bunny.net Stream & Storage
BUNNY_STREAM_LIBRARY_ID=676868
BUNNY_STREAM_API_KEY=CHANGE_ME
BUNNY_STREAM_CDN_HOSTNAME=vz-bb76d46f-94f.b-cdn.net
BUNNY_STREAM_TOKEN_AUTH_KEY=CHANGE_ME
BUNNY_STORAGE_ZONE_NAME=maxxpixels-images
BUNNY_STORAGE_ZONE_PASSWORD=CHANGE_ME
BUNNY_PULL_ZONE_DOMAIN=https://maxxpixels-images.b-cdn.net

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=whsec_CHANGE_ME

# SMS Provider (MSG91)
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=CHANGE_ME
MSG91_TEMPLATE_ID=CHANGE_ME
MSG91_SENDER_ID=MAXXPX
MSG91_TRANSACTIONAL_TEMPLATE_ID=
MSG91_PAYMENT_TEMPLATE_ID=
MSG91_SUBSCRIPTION_TEMPLATE_ID=
MSG91_PRODUCER_TEMPLATE_ID=

# Rate Limiting
DISABLE_RATE_LIMIT=false
RATE_LIMIT_GENERAL_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_PAYMENT_PER_MINUTE=30
