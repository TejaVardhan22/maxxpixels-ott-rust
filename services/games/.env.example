# ============================================================
# maxx-games-service — standalone games Rust service
# Copy to `.env` next to the binary and fill in real values.
# ============================================================

# SEPARATE games database (never point this at the main platform DB)
GAMES_DATABASE_URL=postgres://games_user:games_password@127.0.0.1:5432/maxxpixels_games

# Main NestJS API — used ONLY for GET /api/v1/auth/me (user details)
MAIN_API_URL=https://api.maxxpixels.com

# Same JWT secret as NestJS (validates the mobile app's Bearer tokens)
JWT_SECRET=change_me_same_as_backend

# PlayforFun credentials (server-only; never exposed to clients)
PLAYFORFUN_TENANT_ID=maxxpixels
PLAYFORFUN_SECRET=change_me_pff_hmac_secret
# PFF_SECRET=alternate_env_name_also_accepted

# HTTP listen port
GAMES_SERVICE_PORT=8090

# How long a mirrored player row is trusted before re-syncing from NestJS
PLAYER_TTL_SECONDS=86400

# production | development (dev enables SQL logging)
NODE_ENV=production

# CORS origins, comma separated (default: http://localhost:3000)
CORS_ALLOWED_ORIGINS=https://maxxpixels.com,https://www.maxxpixels.com

# ---- Razorpay coin recharges (server-only) ----
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=razorpay_key_secret
# Separate secret for server webhooks (Dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

# ---- Subscription coin grants (mobile calls POST /games/coins/subscription-grant) ----
# Purchase grant: coins credited when a paid subscription is bought (default 1000)
SUBSCRIPTION_GRANT_COINS=1000
# Monthly claim: coins credited once per calendar month while the plan is valid (default 100)
SUBSCRIPTION_MONTHLY_COINS=100

# Optional: override the coin pack catalog (JSON array)
# COIN_PACKS=[{"id":"starter","coins":100,"amountInr":49,"label":"Starter Pack"},{"id":"gold","coins":3000,"amountInr":899,"label":"Gold Pack"}]

# Log filter (optional; defaults to info)
# RUST_LOG=info,maxx_games_service=debug
