# ==============================================================================
# MaxxPixels games/coins service environment (.env.games)
#
# Source of truth for: games service, games DB, PlayforFun, coin grants.
# Run `python3 scripts/combine_env.py` to regenerate the combined root `.env`.
# ==============================================================================

# --- Games service host port --------------------------------------------------
GAMES_PORT=8090

# --- Separate games database (never point this at the main platform DB) -------
GAMES_DATABASE_URL=CHANGE_ME

# --- Main API (used only for GET /api/v1/auth/me) -----------------------------
MAIN_API_URL=http://api:8081

# --- Shared auth (must match the OTT API JWT_SECRET) --------------------------
JWT_SECRET=CHANGE_ME

# --- Shared CORS (same allow-list as OTT) -------------------------------------
CORS_ALLOWED_ORIGINS=https://maxxpixels.com,https://www.maxxpixels.com,https://admin.maxxpixels.com,https://producer.maxxpixels.com

# --- PlayforFun credentials (server-only; never expose to clients) -----------
PLAYFORFUN_TENANT_ID=maxxpixels
PLAYFORFUN_SECRET=CHANGE_ME
PFF_SECRET=CHANGE_ME

# --- Games service runtime ----------------------------------------------------
GAMES_SERVICE_PORT=8090
PLAYER_TTL_SECONDS=86400
NODE_ENV=production
RUST_LOG=info

# --- Subscription coin grants -------------------------------------------------
SUBSCRIPTION_GRANT_COINS=1000
SUBSCRIPTION_MONTHLY_COINS=100
RAZORPAY_CURRENCY=INR
COIN_PACKS=

# --- Payments (shared with OTT for webhook verification) ----------------------
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
GAMES_RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
