# ==============================================================================
# MaxxPixels OTT — NestJS + Fastify Environment Configuration
# ==============================================================================

# 1. Runtime & Server
NODE_ENV=development
PORT=8081
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://maxxpixels.com,https://admin.maxxpixels.com,http://localhost:4200,http://localhost:3000,http://localhost:8080

# 2. PostgreSQL Database (TypeORM)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_DATABASE=maxxpixels_ott
DB_POOL_MAX=50
DB_POOL_MIN=10
DB_SSL=false

# 3. Redis Distributed Cache, Rate Limiting & Locks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 4. Async Event Bus (Redis Streams)
# Producers XADD to EVENT_BUS_STREAM_KEY; a consumer group drains it on a
# dedicated Redis connection (ack + retry + dead letters). No Kafka broker is
# required. Set EVENT_BUS_ENABLED=false to force the legacy in-process bus.
EVENT_BUS_ENABLED=true
EVENT_BUS_STREAM_KEY=ott:events:stream
EVENT_BUS_DLQ_KEY=ott:events:dlq
EVENT_BUS_CONSUMER_GROUP=ott-workers
EVENT_BUS_MAX_ATTEMPTS=5
# How long a failed event must sit pending before another instance re-claims it.
EVENT_BUS_RECLAIM_MIN_IDLE_MS=30000
# Legacy flags kept for backward compatibility; KAFKA_ENABLED=false disables the bus too.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=maxxpixels-ott-nestjs

# 4b. PlayforFun Gaming (Ludo, Carrom, Snooker, Chess)
# Handled entirely by the standalone Rust games service (services/games-service-rs/).
# Its config (PLAYFORFUN_SECRET, GAMES_DATABASE_URL, ...) lives in that service's .env.
# NestJS no longer implements any games endpoints.

# 5. Keycloak OIDC & JWT Authentication
JWT_SECRET=change-this-to-a-secure-256-bit-production-secret-key-min-32-chars
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000
KEYCLOAK_ENABLED=false
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/maxxpixels
KEYCLOAK_JWKS_URI=http://localhost:8180/realms/maxxpixels/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=account,maxxpixels-client
AUTH_SERVICE_URL=http://localhost:8082

# 6. Storage & Video Streaming (BUNNY or S3)
STORAGE_PROVIDER=BUNNY
STREAM_PROVIDER=BUNNY
BUNNY_STORAGE_ZONE_NAME=maxxpixels-images
BUNNY_STORAGE_ZONE_PASSWORD=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_REGION=de
BUNNY_PULL_ZONE_DOMAIN=https://maxxpixels-images.b-cdn.net
BUNNY_STREAM_LIBRARY_ID=676868
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=vz-bb76d46f-94f.b-cdn.net
BUNNY_STREAM_TOKEN_AUTH_KEY=
# Emit direct Bunny pull-zone media URLs instead of the backend proxy
# (${PUBLIC_BASE_URL}/api/v1/uploads/...). Only enable once the pull zone is not
# suspended; a suspended zone answers 403 for every object.
MEDIA_DIRECT_CDN=false

S3_MASTER_BUCKET=maxxpixels-ott-assets
S3_AWS_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=
S3_CDN_DOMAIN=https://cdn.maxxpixels.com

# 7. Payment Gateways (RAZORPAY or STRIPE)
PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 8. Notifications (FCM & MSG91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MAXXPX
MSG91_TEMPLATE_ID=
FCM_PROJECT_ID=maxxpixelsott
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_JSON=

# 9. Admin Seed & Scheduled Backups
APP_ADMIN_DEFAULT_EMAIL=admin@maxxpixels.com
APP_ADMIN_DEFAULT_PASSWORD=
APP_BACKUP_CRON=0 0 2 * * *

# Existing VPS: explicitly control startup schema writes and background jobs.
# SKIP_DB_INIT disables seeding; DB_SCHEMA_PATCHES_ENABLED also controls DDL.
DB_SCHEMA_PATCHES_ENABLED=true
SKIP_DB_INIT=false
OUTBOX_RELAY_ENABLED=true
NIGHTLY_BACKUP_ENABLED=true

